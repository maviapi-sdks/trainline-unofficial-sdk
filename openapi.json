{
  "openapi": "3.1.0",
  "info": {
    "title": "Trainline API",
    "version": "2026-11-27",
    "description": "Train ticket fares and departure times between any two stations on Trainline (thetrainline.com).\n\nEvery request needs an API key in the `Authorization: Bearer <key>` header. Create one at https://maviapi.com/dashboard/keys. A successful request uses one credit, unless its operation says more (`x-credits`). That price covers 200 rows (or the operation's `x-credits-rows`); a request that returns more pays it again for each further page of that many rows. The `x-maviapi-credits` response header says what a request cost. A query param an operation does not take is ignored and named in the `x-maviapi-unknown-params` response header; send the `x-maviapi-strict: 1` request header to have such a request refused with a free `400 unknown_param` instead.\n\nEndpoint reference with live examples: https://maviapi.com/apis/thetrainline",
    "termsOfService": "https://maviapi.com/terms"
  },
  "externalDocs": {
    "description": "API page",
    "url": "https://maviapi.com/apis/thetrainline"
  },
  "servers": [
    {
      "url": "https://api.maviapi.com/v1/sites/thetrainline"
    }
  ],
  "security": [
    {
      "maviapiKey": []
    }
  ],
  "paths": {
    "/fares": {
      "get": {
        "operationId": "fares",
        "summary": "Fares",
        "description": "The fare window between two places: origin, destination, the window's dates, its cheapest day and price, and `days`, the list of priced days in date order, each with its cheapest single (one-way) fare and the departure times of the cheapest trains. Days Trainline holds no fare data for may be missing or come back with date and cheapest_price null.\n\nEach successful request uses 5 credits.",
        "x-credits": 5,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "origin, a place or station name (best match is used, as in /locations) or a Trainline urn code",
            "schema": {
              "type": "string",
              "default": "london"
            },
            "example": "london"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "destination, a place or station name or a Trainline urn code",
            "schema": {
              "type": "string",
              "default": "manchester"
            },
            "example": "manchester"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "first day of the window, YYYY-MM-DD (UTC); defaults to today",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "number of days to price starting at `date`, 1-14",
            "schema": {
              "type": "integer",
              "default": 3
            },
            "example": 3
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "currency of the fares (GBP, EUR, USD, CHF, DKK, SEK or NOK)",
            "schema": {
              "enum": [
                "GBP",
                "EUR",
                "USD",
                "CHF",
                "DKK",
                "SEK",
                "NOK"
              ],
              "type": "string",
              "default": "GBP"
            },
            "example": "GBP"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows in one page, 1 to 200 (default 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip before the page starts (default 0).",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "$ref": "#/components/parameters/Fields"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/MaxAge"
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as JSON.",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests the key may make in the current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in the current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the window starts again.",
                "schema": {
                  "type": "integer"
                }
              },
              "x-maviapi-unknown-params": {
                "description": "Query params this endpoint does not take, comma separated; they were ignored. Send `x-maviapi-strict: 1` to get a free `400 unknown_param` instead.",
                "schema": {
                  "type": "string"
                }
              },
              "Age": {
                "description": "Seconds since the data was read from the site, as the body's `age`.",
                "schema": {
                  "type": "integer"
                }
              },
              "x-maviapi-fetched-at": {
                "description": "When the data was read from the site (ISO 8601, UTC), as the body's `fetched_at`.",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "origin": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "example": "London"
                            },
                            "code": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "example": "urn:trainline:generic:loc:182gb"
                            }
                          }
                        },
                        "destination": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "example": "Manchester Piccadilly"
                            },
                            "code": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "example": "urn:trainline:generic:loc:MAN2968gb"
                            }
                          }
                        },
                        "currency": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "GBP"
                        },
                        "journey_type": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "single"
                        },
                        "date_from": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-11-27"
                        },
                        "date_to": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-11-29"
                        },
                        "cheapest_price": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "example": 21.9
                        },
                        "cheapest_date": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-11-28"
                        },
                        "days": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "2026-11-27"
                              },
                              "cheapest_price": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "example": 36
                              },
                              "currency": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "GBP"
                              },
                              "departures": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "string",
                                  "example": "2026-11-27T19:46:00.000Z"
                                }
                              }
                            }
                          }
                        },
                        "pagination": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "count": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "example": 3
                            },
                            "has_more": {
                              "type": [
                                "boolean",
                                "null"
                              ],
                              "example": false
                            },
                            "next_cursor": {
                              "type": "null",
                              "example": null
                            }
                          }
                        },
                        "fetched_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-11-27T10:16:44.709Z"
                        },
                        "age": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "example": 0
                        }
                      }
                    },
                    "cached": {
                      "type": "boolean",
                      "description": "Whether this answer was served from the stored copy."
                    },
                    "source": {
                      "description": "Where the data was read from."
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "count": {
                          "type": "integer"
                        },
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "$ref": "#/components/schemas/NextCursor"
                        }
                      }
                    },
                    "fetched_at": {
                      "$ref": "#/components/schemas/FetchedAt"
                    },
                    "age": {
                      "$ref": "#/components/schemas/Age"
                    }
                  },
                  "required": [
                    "data",
                    "cached",
                    "source"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/CreditLimitReached"
          },
          "403": {
            "$ref": "#/components/responses/AccountSuspended"
          },
          "410": {
            "$ref": "#/components/responses/CursorExpired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailed"
          }
        }
      }
    },
    "/locations": {
      "get": {
        "operationId": "locations",
        "summary": "Locations",
        "description": "Trainline stations and places matching a name, best match first, with the urn codes that /fares accepts.\n\nEach successful request uses 5 credits.",
        "x-credits": 5,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "search term, a station or place name (e.g. \"london\", \"paris nord\")",
            "schema": {
              "type": "string",
              "default": "london"
            },
            "example": "london"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows in one page, 1 to 200 (default 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip before the page starts (default 0).",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "$ref": "#/components/parameters/Fields"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/MaxAge"
          }
        ],
        "responses": {
          "200": {
            "description": "The data, as JSON.",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests the key may make in the current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in the current window.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the window starts again.",
                "schema": {
                  "type": "integer"
                }
              },
              "x-maviapi-unknown-params": {
                "description": "Query params this endpoint does not take, comma separated; they were ignored. Send `x-maviapi-strict: 1` to get a free `400 unknown_param` instead.",
                "schema": {
                  "type": "string"
                }
              },
              "Age": {
                "description": "Seconds since the data was read from the site, as the body's `age`.",
                "schema": {
                  "type": "integer"
                }
              },
              "x-maviapi-fetched-at": {
                "description": "When the data was read from the site (ISO 8601, UTC), as the body's `fetched_at`.",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "query": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "london"
                        },
                        "locations": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "London"
                              },
                              "code": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "urn:trainline:generic:loc:182gb"
                              },
                              "type": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "stationGroup"
                              },
                              "country": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "GB"
                              },
                              "subtitle": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "example": "Any"
                              }
                            }
                          }
                        },
                        "pagination": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "count": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "example": 30
                            },
                            "has_more": {
                              "type": [
                                "boolean",
                                "null"
                              ],
                              "example": false
                            },
                            "next_cursor": {
                              "type": "null",
                              "example": null
                            }
                          }
                        },
                        "fetched_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "example": "2026-11-27T10:15:54.995Z"
                        },
                        "age": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "example": 0
                        }
                      }
                    },
                    "cached": {
                      "type": "boolean",
                      "description": "Whether this answer was served from the stored copy."
                    },
                    "source": {
                      "description": "Where the data was read from."
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "count": {
                          "type": "integer"
                        },
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "$ref": "#/components/schemas/NextCursor"
                        }
                      }
                    },
                    "fetched_at": {
                      "$ref": "#/components/schemas/FetchedAt"
                    },
                    "age": {
                      "$ref": "#/components/schemas/Age"
                    }
                  },
                  "required": [
                    "data",
                    "cached",
                    "source"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/CreditLimitReached"
          },
          "403": {
            "$ref": "#/components/responses/AccountSuspended"
          },
          "410": {
            "$ref": "#/components/responses/CursorExpired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "maviapiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your maviapi API key, sent as `Authorization: Bearer <key>`. Create one at https://maviapi.com/dashboard/keys."
      }
    },
    "parameters": {
      "Fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Row fields to keep in a list answer, comma separated (at most 50). A dot reaches into an object, or into each object of an array (venue.city). A name no row has is a 400 that lists the fields a row has.",
        "schema": {
          "type": "string"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "pagination.next_cursor of the previous page, sent with the same other params: the next page of the same stored copy of the list, so a walk never skips or repeats a row when the cache refreshes or the site reorders. A cursor for other params is 400 invalid_cursor; a copy that is gone is 410 cursor_expired (start again without cursor).",
        "schema": {
          "type": "string"
        }
      },
      "MaxAge": {
        "name": "max_age",
        "in": "query",
        "required": false,
        "description": "Serve a stored answer only when it was read at most this many seconds ago (0 to 86400); older, the site is read again. 0 is refresh=true. Any other value is 400 invalid_max_age.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message",
          "retryable"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code, e.g. `rate_limited`."
          },
          "message": {
            "type": "string",
            "description": "What went wrong, in a sentence."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether the same request may succeed later without any change. When true, wait the seconds in `Retry-After` (if sent) first."
          }
        }
      },
      "FetchedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time",
        "description": "When this data was read from the site (ISO 8601, UTC). Also in the x-maviapi-fetched-at header.",
        "example": "2026-11-25T09:30:00.000Z"
      },
      "Age": {
        "type": [
          "integer",
          "null"
        ],
        "description": "Seconds since fetched_at: 0 for a fresh read, more for a stored answer. Also in the Age header.",
        "example": 0
      },
      "NextCursor": {
        "type": [
          "string",
          "null"
        ],
        "description": "Send as `cursor`, with the same other params, for the next page of the same copy of the list; null on the last page."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A parameter is missing or cannot be used (`bad_request`), or, with the `x-maviapi-strict: 1` request header, a query param the operation does not take was sent (`unknown_param`, with the names in `params`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "bad_request",
              "message": "Missing required query parameter: q",
              "retryable": false
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No API key was sent, or the key is invalid or revoked (`missing_api_key`, `invalid_api_key`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "missing_api_key",
              "message": "Provide an API key via the Authorization: Bearer <key> header.",
              "retryable": false
            }
          }
        }
      },
      "CreditLimitReached": {
        "description": "The plan's credits for this period are used up.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "credit_limit_reached",
              "message": "You've used all 1,000 credits in your Free plan for this period. Upgrade your plan for a higher allotment.",
              "retryable": false
            }
          }
        }
      },
      "AccountSuspended": {
        "description": "The account that owns the key is suspended.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "account_banned",
              "message": "Your account is suspended.",
              "retryable": false
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests for this key (`rate_limited`), or too many at once for its plan (`concurrency_limited`). Wait the number of seconds in `Retry-After`.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "rate_limited",
              "message": "Rate limit exceeded for this API key (600 requests a minute).",
              "retryable": true
            }
          }
        }
      },
      "UpstreamFailed": {
        "description": "The source site could not be read this time. Retrying later usually works.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "scrape_failed",
              "message": "The upstream source could not be fetched",
              "retryable": true
            }
          }
        }
      },
      "CursorExpired": {
        "description": "The stored copy of the list this cursor walks is gone. Start the list again without cursor.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "cursor_expired",
              "message": "The copy of the list this cursor walks is gone. Start the list again without cursor.",
              "retryable": false
            }
          }
        }
      }
    }
  }
}
